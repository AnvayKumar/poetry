["\u0930\u093e\u0939\u094b\u0902 \u092a\u0930 \u091a\u0932\u0924\u0947-\u091a\u0932\u0924\u0947,\n\u0927\u0942\u0932 \u092d\u0940 \u0938\u093e\u0925 \u0906\u0908\n\u0915\u0941\u091b \u091c\u0940\u0924\u0947\u0902 \u092e\u093f\u0932\u0940\u0902 \u0939\u092e\u0947\u0902,\n\u0915\u092d\u0940 \u0939\u093e\u0930 \u092d\u0940 \u0938\u093e\u0925 \u0906\u0908\n\n\u0915\u0941\u091b \u091a\u0947\u0939\u0930\u0947 \u092e\u093f\u0932\u0947 \u0925\u0947,\n\u092b\u093f\u0930 \u0916\u094b \u092d\u0940 \u0917\u090f\n\u0915\u0941\u091b \u0930\u093f\u0936\u094d\u0924\u0947 \u092c\u0939\u0941\u0924 \u0917\u0939\u0930\u0947 \u0925\u0947,\n\u092a\u0930 \u0938\u094b \u092d\u0940 \u0917\u090f\n\n\u092f\u0947 \u091c\u094b \u0917\u0941\u091c\u093c\u0930\u093e \u0939\u0948,\n\u092f\u0947 \u092f\u093e\u0926\u0947\u0902 \u0928\u0939\u0940\u0902, \u092f\u0947 \u090f\u0939\u0938\u093e\u0938 \u0939\u0948..", "\u0905\u0927\u0942\u0930\u093e \u0939\u0942\u0901 \u092e\u0948\u0902, \u0905\u0927\u0942\u0930\u0940 \u092e\u0947\u0930\u0940 \u092c\u093e\u0924 \u0939\u0948 \n\u0905\u0927\u0942\u0930\u093e \u0905\u092c \u0915\u0941\u091b \u0928\u0939\u0940\u0902, \u0905\u0917\u0930 \u0924\u0942 \u092e\u0947\u0930\u0947 \u0938\u093e\u0925 \u0939\u0948", "\u0917\u0930\u094d\u0935 \u0924\u094b \u092c\u0939\u0941\u0924 \u0939\u094b\u0924\u093e \u0939\u0948\n\u0924\u093f\u0930\u0902\u0917\u093e \u0939\u0935\u093e \u092e\u0947\u0902 \u0932\u0939\u0930\u093e\u0924\u093e \u0926\u0947\u0916 \u0915\u0947\n\u092a\u0930 \u0906\u091c\u093c\u093e\u0926\u0940 \u0915\u0947 \u0926\u093f\u0935\u0938 \u0915\u0947 \u0905\u0917\u0932\u0947 \u0939\u0940 \u0926\u093f\u0928\n\u092e\u0948\u0902\u0928\u0947 \u092f\u0947 \u0924\u093f\u0930\u0902\u0917\u0947 \u0938\u0921\u0915\u094b\u0902 \u092a\u0930 \u092c\u093f\u0916\u0930\u0947 \u0926\u0947\u0916\u0947"]