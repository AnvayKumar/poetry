["\u0938\u093f\u0930\u094d\u092b \u092e\u0928\u091a\u093e\u0939\u093e \u0915\u0930\u0928\u093e \u0906\u091c\u093c\u093e\u0926\u0940 \u0928\u0939\u0940\u0902,\n\u0916\u0941\u0932\u0940 \u0939\u0935\u093e \u092e\u0947\u0902 \u0938\u093e\u0901\u0938 \u0932\u0947\u0928\u093e \u0906\u091c\u093c\u093e\u0926\u0940 \u0928\u0939\u0940\u0902\n\u0906\u091c\u093c\u093e\u0926\u0940 \u0924\u094b \u0935\u0939 \u091c\u0941\u0928\u0942\u0928 \u0939\u0948\n\u091c\u093f\u0938\u0947 \u091c\u0940\u090f \u092c\u093f\u0928\u093e \u0906\u091c\u093c\u093e\u0926\u0940 \u0928\u0939\u0940\u0902", "\u0915\u0939\u0928\u0947 \u0915\u094b \u0924\u094b \u0915\u0941\u091b \u0932\u093f\u0916\u0924\u093e \u0939\u0942\u0901 \u092e\u0948\u0902\n\u092a\u0930 \u092e\u0947\u0930\u0940 \u0932\u093f\u0916\u093e\u0935\u091f \u0915\u093e \u0938\u092c\u092c \u0939\u0948\u0902 \u0935\u094b\n\u0939\u0930 \u0916\u093e\u0932\u0940 \u0915\u093e\u0917\u091c\u093c \u0915\u094b \u092d\u0930 \u0926\u0947\u0902\n\u0910\u0938\u0940 \u0905\u0939\u092e\u093f\u092f\u0924 \u0915\u0940 \u0938\u093e\u091c\u093c \u0939\u0948\u0902 \u0935\u094b", "\u0905\u0927\u0942\u0930\u093e \u0939\u0942\u0901 \u092e\u0948\u0902, \u0905\u0927\u0942\u0930\u0940 \u092e\u0947\u0930\u0940 \u092c\u093e\u0924 \u0939\u0948 \n\u0905\u0927\u0942\u0930\u093e \u0905\u092c \u0915\u0941\u091b \u0928\u0939\u0940\u0902, \u0905\u0917\u0930 \u0924\u0942 \u092e\u0947\u0930\u0947 \u0938\u093e\u0925 \u0939\u0948", "\u0935\u0958\u094d\u0924 \u0915\u094b \u0917\u0941\u095b\u0930\u0924\u0947 \u0926\u0947\u0916\u093e \u0939\u0948 \u0915\u092d\u0940?\n\u0924\u0942\u095e\u093e\u0928 \u091c\u0948\u0938\u0940 \u092c\u093f\u0916\u0947\u0930\u0940 \u0939\u0948\n\u0905\u0902\u0917\u093e\u0930\u094b\u0902 \u0915\u0940 \u092d\u0940 \u092e\u0942\u0930\u0924 \u092c\u0928\u093e \u0926\u0947\n\u092c\u0938 \u0925\u094b\u095c\u093e \u0917\u0941\u095b\u0930\u0928\u0947 \u0915\u0940 \u0926\u0947\u0930\u0940 \u0939\u0948", "\u091c\u093c\u0930\u093e \u0938\u093e \u0935\u0958\u094d\u0924 \u0930\u0941\u0915 \u091c\u093e\u090f \u0915\u0939\u0940\u0902\n\u0938\u093f\u0930\u094d\u092b \u090f\u0915 \u0932\u092e\u094d\u0939\u093e \u0920\u0939\u0930 \u091c\u093e\u090f \u0915\u0939\u0940\u0902\n\u0909\u0938 \u0932\u092e\u094d\u0939\u0947 \u092e\u0947\u0902 \u091b\u093f\u092a\u0940 \u0939\u0948\u0902 \u0905\u0917\u0923\u093f\u0924 \u0915\u0939\u093e\u0928\u093f\u092f\u093e\u0901\n\u091c\u094b \u0939\u094b\u0924\u0940 \u0928\u0939\u0940\u0902 \u092c\u092f\u093e\u0902 \u0935\u0958\u094d\u0924 \u0915\u0940 \u0917\u0939\u0930\u093e\u0908 \u092e\u0947\u0902 \u0915\u0939\u0940\u0902"]