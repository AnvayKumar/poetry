["\u091c\u092c \u092c\u0940\u0924 \u091c\u093e\u092f\u0947\u0902\u0917\u0947 \u092f\u0947 \u0926\u093f\u0928, \u092f\u0947 \u0930\u093e\u0924\u0947\u0902,\n\u0938\u093f\u0930\u094d\u092b \u092f\u093e\u0926\u094b\u0902 \u0915\u0940 \u0930\u094b\u0936\u0928\u0940 \u092c\u091a\u0940 \u0930\u0939\u0947\u0917\u0940\n\u0939\u0930 \u092c\u0940\u0924\u0924\u0947 \u092a\u0939\u0930 \u092e\u0947\u0902 \u0927\u0942\u092a \u0915\u0940 \u0924\u092a\u0928 \u0915\u0940 \u0924\u0930\u0939\n\u0907\u0938 \u0935\u0958\u094d\u0924 \u0915\u094b \u0917\u0941\u095b\u0930\u0924\u0947 \u0926\u0947\u0930 \u0928\u093e \u0932\u0917\u0947\u0917\u0940", "\u090a\u0901\u091a\u0940 \u0926\u0941\u0915\u093e\u0928\u094b\u0902 \u092e\u0947\u0902 \u0916\u0930\u094d\u091a\u093e \u0915\u0930\u0915\u0947 \u0926\u093f\u0916\u093e\u0935\u093e \u0915\u093f\u092f\u093e \u091c\u093e\u0924\u093e \u0939\u0948\n\u0920\u0947\u0932\u0947 \u092a\u0947 \u0938\u092c\u094d\u091c\u0940 \u0935\u093e\u0932\u0947 \u0938\u0947 \u092e\u094b\u0932 \u092d\u093e\u0935 \u0915\u093f\u092f\u093e \u091c\u093e\u0924\u093e \u0939\u0948\n\u0907\u0902\u0938\u093e\u0928\u093f\u092f\u0924 \u0915\u0947 \u0928\u093e\u092e \u092a\u0947 \u0939\u0930 \u0930\u094b\u095b \u0939\u094b\u0924\u0940 \u092f\u0947 \u092e\u0915\u094d\u0915\u093e\u0930\u0940 \u0939\u0948\n\u0938\u092e\u093e\u091c \u0915\u094b \u0917\u093e\u0932\u0940 \u0915\u094d\u092f\u094b\u0902 \u0926\u0947\u0924\u0947 \u0939\u0948\u0902, \u092f\u0947 \u0938\u092e\u093e\u091c \u092a\u0930\u091b\u093e\u0908 \u0939\u092e\u093e\u0930\u0940 \u0939\u0948", "\u092e\u093f\u091f\u094d\u091f\u0940 \u0938\u0947 \u092e\u0948\u0932\u0947 \u0939\u093e\u0925, \u092a\u0930 \u092c\u094b \u0930\u0939\u093e \u0939\u0942\u0901 \u0938\u092a\u0928\u0947\n\u0939\u0930 \u092c\u0940\u091c \u092e\u0947\u0902 \u0906\u0936\u093e, \u0939\u0930 \u0915\u0923 \u092e\u0947\u0902 \u0905\u092a\u0928\u0947\n\u0915\u0932 \u0905\u0902\u0915\u0941\u0930 \u092b\u0942\u091f\u0947\u0917\u093e, \u0928\u0928\u094d\u0939\u0940 \u0915\u0932\u0940 \u092e\u0941\u0938\u094d\u0915\u093e\u092f\u0947\u0917\u0940\n\u092b\u093f\u0930 \u092a\u094d\u092f\u093e\u0930 \u0938\u0947 \u091d\u0941\u0915\u0947\u0917\u0940 \u0914\u0930 \u0936\u093e\u0959 \u092a\u0947 \u0932\u0939\u0930\u093e\u092f\u0947\u0917\u0940", "\u0936\u0940\u0936 \u0915\u091f\u093e \u091c\u092c \u0938\u093f\u092a\u093e\u0939\u0940 \u0915\u093e \u0924\u094b \u0915\u0941\u091b \u0926\u093f\u0928 \u092e\u0947\u0902 \u092d\u0941\u0932\u093e \u0926\u093f\u092f\u093e\n\u092c\u0947\u092c\u0938 \u0909\u0928 \u092a\u0930\u093f\u0935\u093e\u0930\u094b\u0902 \u0915\u0947 \u0926\u093f\u0932\u094b\u0902 \u0915\u094b \u0938\u0941\u0932\u0917\u093e \u0926\u093f\u092f\u093e \n\u092f\u093e\u0926 \u0909\u0928\u094d\u0939\u0947\u0902 \u0915\u0930\u0928\u093e \u092d\u0940 \u0924\u094b \u0939\u092e\u093e\u0930\u0940 \u0939\u0940 \u095b\u093f\u092e\u094d\u092e\u0947\u0926\u093e\u0930\u0940 \u0939\u0948\n\u0938\u092e\u093e\u091c \u0915\u094b \u0917\u093e\u0932\u0940 \u0915\u094d\u092f\u094b\u0902 \u0926\u0947\u0924\u0947 \u0939\u0948\u0902, \u092f\u0947 \u0938\u092e\u093e\u091c \u092a\u0930\u091b\u093e\u0908 \u0939\u092e\u093e\u0930\u0940 \u0939\u0948", "\u091c\u093c\u0930\u0942\u0930\u0940 \u0928\u0939\u0940\u0902 \u091c\u094b \u091a\u0941\u092a \u092c\u0948\u0920\u093e \u0939\u094b, \u0909\u0926\u093e\u0938 \u0939\u0940 \u0939\u094b\n\u0939\u094b \u0938\u0915\u0924\u093e \u0939\u0948 \u092c\u0938 group chat mute \u0915\u093f\u092f\u093e \u0939\u094b...\n\u0938\u094b\u091a\u093e \u0939\u094b\u0917\u093e \u0926\u094b \u092e\u093f\u0928\u091f \u092e\u0947\u0902 \u0909\u0920 \u091c\u093e\u090a\u0902\u0917\u093e\n\u0914\u0930 \u092b\u093f\u0930 scroll \u0915\u0930\u0924\u0947-\u0915\u0930\u0924\u0947 \u0926\u093f\u0928 \u0939\u0940 \u092c\u0940\u0924 \u0917\u092f\u093e \u0939\u094b"]