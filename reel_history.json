["\u092a\u0938\u0940\u0928\u0947 \u0915\u0940 \u090f\u0915 \u092c\u0942\u0901\u0926 \u091c\u092c \u092e\u093f\u091f\u094d\u091f\u0940 \u092e\u0947\u0902 \u092e\u093f\u0932\u0940\n\u092e\u0947\u0939\u0928\u0924 \u0915\u0940 \u092e\u0939\u0915 \u0939\u0930 \u0915\u094b\u0928\u0947 \u092e\u0947\u0902 \u0916\u093f\u0932\u0940\n\u0938\u093f\u0930\u094d\u092b \u0936\u094d\u0930\u092e \u0938\u0947 \u0928\u0939\u0940\u0902 \u0939\u094b\u0924\u0940 \u092f\u0947 \u0927\u0930\u0924\u0940 \u0939\u0930\u0940\n\u0925\u094b\u095c\u093e \u092a\u094d\u092f\u093e\u0930, \u0925\u094b\u095c\u093e \u0938\u092c\u094d\u0930 \u092d\u0940 \u0939\u0948 \u095b\u0930\u0942\u0930\u0940", "\u0915\u092d\u0940 \u0916\u0941\u0926 \u0938\u0947 \u0932\u0921\u093c\u0947 \u0939\u092e,\n\u0915\u092d\u0940 \u0926\u0941\u0928\u093f\u092f\u093e \u0938\u0947 \u092d\u0940\n\u0915\u092d\u0940 \u0938\u091a \u0915\u0947 \u0932\u093f\u090f \u0916\u0921\u093c\u0947,\n\u0915\u092d\u0940 \u091a\u0941\u092a \u0925\u0947 \u0938\u092d\u0940\n\n\u0915\u0941\u091b \u0930\u093f\u0936\u094d\u0924\u0947 \u0925\u093e\u092e\u0947 \u0925\u0947,\n\u0926\u093f\u0932 \u0915\u0940 \u0921\u094b\u0930 \u0938\u0947\n\u0915\u0941\u091b \u091b\u0942\u091f \u0917\u090f \u0927\u0940\u0930\u0947-\u0927\u0940\u0930\u0947\n\u0938\u092e\u092f \u0915\u0940 \u0939\u094b\u0921\u093c \u092e\u0947\u0902\n\n\u092f\u0947 \u091c\u094b \u0917\u0941\u091c\u093c\u0930\u093e \u0939\u0948,\n\u092f\u0947 \u092b\u093c\u093e\u0938\u0932\u0947 \u0928\u0939\u0940\u0902, \u092f\u0947 \u092a\u0939\u091a\u093e\u0928 \u0939\u0948..", "\u091c\u093c\u0930\u093e \u0938\u093e \u0935\u0958\u094d\u0924 \u0930\u0941\u0915 \u091c\u093e\u090f \u0915\u0939\u0940\u0902\n\u0938\u093f\u0930\u094d\u092b \u090f\u0915 \u0932\u092e\u094d\u0939\u093e \u0920\u0939\u0930 \u091c\u093e\u090f \u0915\u0939\u0940\u0902\n\u0909\u0938 \u0932\u092e\u094d\u0939\u0947 \u092e\u0947\u0902 \u091b\u093f\u092a\u0940 \u0939\u0948\u0902 \u0905\u0917\u0923\u093f\u0924 \u0915\u0939\u093e\u0928\u093f\u092f\u093e\u0901\n\u091c\u094b \u0939\u094b\u0924\u0940 \u0928\u0939\u0940\u0902 \u092c\u092f\u093e\u0902 \u0935\u0958\u094d\u0924 \u0915\u0940 \u0917\u0939\u0930\u093e\u0908 \u092e\u0947\u0902 \u0915\u0939\u0940\u0902", "\u0917\u093c\u0941\u0938\u094d\u0938\u0947 \u0938\u0947 \u0909\u092c\u0932\u0924\u0947 \u091c\u091c\u093c\u094d\u092c\u093e\u0924 \u0915\u0947 \u0938\u093e\u092e\u0928\u0947\n\u0938\u0928\u094d\u0928\u093e\u091f\u0947 \u0915\u0940 \u0928\u0930\u092e \u0917\u0942\u0901\u091c \u0939\u0948\u0902 \u0935\u094b\n\u0925\u0915\u093e\u0928 \u0938\u0947 \u0932\u0939\u0942\u0932\u0941\u0939\u093e\u0928 \u0907\u0938 \u0938\u092b\u093c\u0930 \u092e\u0947\u0902\n\u0939\u0930 \u092e\u094b\u0921\u093c \u092a\u0930 \u092e\u093f\u0932\u0924\u0940 \u0930\u0939\u092e\u0924 \u0939\u0948\u0902 \u0935\u094b", "\u0935\u0958\u094d\u0924 \u0915\u094b \u0917\u0941\u095b\u0930\u0924\u0947 \u0926\u0947\u0916\u093e \u0939\u0948 \u0915\u092d\u0940?\n\u0924\u0942\u095e\u093e\u0928 \u091c\u0948\u0938\u0940 \u092c\u093f\u0916\u0947\u0930\u0940 \u0939\u0948\n\u0907\u0938 \u092e\u0941\u0936\u094d\u0915\u093f\u0932 \u0926\u094c\u0930 \u092e\u0947\u0902 \u0909\u095c\u093e\u0928 \u092d\u0930\u0928\u0947 \u0915\u094b\n\u092c\u0938 \u0925\u094b\u095c\u0947 \u0938\u093e\u0939\u0938 \u0915\u0940 \u0926\u0947\u0930\u0940 \u0939\u0948"]