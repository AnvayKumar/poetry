["\u092e\u0947\u0930\u0947 \u0906\u091c \u092f\u0939\u093e\u0901 \u0939\u094b\u0928\u0947 \u092a\u0947 \u0939\u0948\u0930\u093e\u0928 \u0925\u0947 \u0935\u094b\n\u0915\u094d\u092f\u0942\u0902\u0915\u093f \u0909\u0928\u094d\u0939\u0947\u0902 \u092e\u0947\u0930\u0947 \u092a\u0948\u0930 \u0915\u0947 \u091b\u093e\u0932\u0947 \u0928\u093e \u0926\u093f\u0916\u0947 \n\u0909\u0928\u0938\u0947 \u0930\u0902\u091c\u093f\u0936 \u092e\u0928 \u092e\u0947\u0902 \u0915\u094d\u092f\u094b\u0902 \u0930\u0916\u0942\u0902\n\u092e\u0947\u0930\u0940 \u0938\u0902\u0918\u0930\u094d\u0937 \u0915\u0940 \u0926\u093e\u0938\u094d\u0924\u093e\u0901 \u0939\u0948, \u092c\u0938 \u092a\u0928\u094d\u0928\u0947 \u0939\u0948\u0902 \u0905\u0928\u0932\u093f\u0916\u0947", "\u092e\u0941\u0936\u094d\u0915\u093f\u0932 \u092d\u0930\u0940 \u0930\u093e\u0939 \u0939\u094b\u0917\u0940\n\u0928\u095b\u0930-\u0910-\u0926\u0942\u0930\u0940 \u0924\u0928\u0939\u093e \u0939\u094b\u0917\u0940\n\u092e\u0941\u091d\u0947 \u092f\u0915\u0940\u0928 \u0939\u0948\n\u0907\u0928 \u0930\u093e\u0938\u094d\u0924\u094b\u0902 \u092a\u0947 \u0939\u092e \u092b\u093f\u0930 \u092e\u093f\u0932\u0947\u0902\u0917\u0947\n\u092c\u0938 \u0907\u0924\u0928\u093e \u092c\u0924\u093e\u0913\n\u092e\u0947\u0930\u0947 \u0938\u093e\u0925 \u091a\u0932\u094b\u0917\u0940 \u0915\u094d\u092f\u093e?", "\u0926\u0947\u0930 \u0938\u0947 \u0915\u092d\u0940 \u0918\u0930 \u0906\u090a\u0902 \u0924\u094b, \n\u0928\u093e\u0915 \u092a\u0947 \u0917\u0941\u0938\u094d\u0938\u093e \u0932\u093f\u090f \u0926\u093f\u0916\u0924\u0940 \u0939\u0948\n\u092a\u0930 \u0916\u093c\u094d\u0935\u093e\u092c\u094b\u0902 \u092e\u0947\u0902 \u0939\u092e\u0947\u0936\u093e \u092e\u0941\u091d\u0947, \n\u0935\u094b \u092e\u0941\u0938\u094d\u0915\u0941\u0930\u093e\u0924\u0947 \u0939\u0941\u090f \u092e\u093f\u0932\u0924\u0940 \u0939\u0948", "\u0915\u092d\u0940 \u0916\u0941\u0926 \u0938\u0947 \u0932\u0921\u093c\u0947 \u0939\u092e,\n\u0915\u092d\u0940 \u0926\u0941\u0928\u093f\u092f\u093e \u0938\u0947 \u092d\u0940\n\u0915\u092d\u0940 \u0938\u091a \u0915\u0947 \u0932\u093f\u090f \u0916\u0921\u093c\u0947,\n\u0915\u092d\u0940 \u091a\u0941\u092a \u0925\u0947 \u0938\u092d\u0940\n\n\u0915\u0941\u091b \u0930\u093f\u0936\u094d\u0924\u0947 \u0925\u093e\u092e\u0947 \u0925\u0947,\n\u0926\u093f\u0932 \u0915\u0940 \u0921\u094b\u0930 \u0938\u0947\n\u0915\u0941\u091b \u091b\u0942\u091f \u0917\u090f \u0927\u0940\u0930\u0947-\u0927\u0940\u0930\u0947\n\u0938\u092e\u092f \u0915\u0940 \u0939\u094b\u0921\u093c \u092e\u0947\u0902\n\n\u092f\u0947 \u091c\u094b \u0917\u0941\u091c\u093c\u0930\u093e \u0939\u0948,\n\u092f\u0947 \u092b\u093c\u093e\u0938\u0932\u0947 \u0928\u0939\u0940\u0902, \u092f\u0947 \u092a\u0939\u091a\u093e\u0928 \u0939\u0948..", "\u0938\u093f\u0930\u094d\u092b \u092e\u0928\u091a\u093e\u0939\u093e \u0915\u0930\u0928\u093e \u0906\u091c\u093c\u093e\u0926\u0940 \u0928\u0939\u0940\u0902,\n\u0916\u0941\u0932\u0940 \u0939\u0935\u093e \u092e\u0947\u0902 \u0938\u093e\u0901\u0938 \u0932\u0947\u0928\u093e \u0906\u091c\u093c\u093e\u0926\u0940 \u0928\u0939\u0940\u0902\n\u0906\u091c\u093c\u093e\u0926\u0940 \u0924\u094b \u0935\u0939 \u091c\u0941\u0928\u0942\u0928 \u0939\u0948\n\u091c\u093f\u0938\u0947 \u091c\u0940\u090f \u092c\u093f\u0928\u093e \u0906\u091c\u093c\u093e\u0926\u0940 \u0928\u0939\u0940\u0902"]