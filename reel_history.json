["\u0915\u0932 \u0915\u0940 \u091a\u093f\u0902\u0924\u093e \u092e\u0947\u0902,\n\u0906\u091c \u0915\u094b \u0916\u094b\u092f\u093e\n\u092c\u0940\u0924\u0947 \u092a\u0932\u094b\u0902 \u0915\u094b \u092f\u093e\u0926 \u0915\u0930,\n\u0905\u0915\u094d\u0938\u0930 \u092c\u0939\u0941\u0924 \u0930\u094b\u092f\u093e\n\n\u0938\u092e\u091d \u0906\u092f\u093e \u0927\u0940\u0930\u0947-\u0927\u0940\u0930\u0947,\n\u0939\u0930 \u0920\u094b\u0915\u0930 \u0915\u093e \u092e\u0924\u0932\u092c \u0925\u093e\n\u091c\u094b \u092c\u0940\u0924\u093e \u0935\u0939\u0940 \u092d\u0940\u0924\u0930\n\u092e\u0947\u0930\u0947 \u0939\u094b\u0928\u0947 \u0915\u093e \u0938\u092c\u0915 \u0925\u093e\n\n\u092f\u0947 \u091c\u094b \u0917\u0941\u091c\u093c\u0930\u093e \u0939\u0948,\n\u092f\u0947 \u0935\u0915\u093c\u094d\u0924 \u0928\u0939\u0940\u0902, \u092f\u0947 \u091c\u0940\u0935\u0928 \u0939\u0948..", "\u091c\u093c\u0930\u0942\u0930\u0940 \u0928\u0939\u0940\u0902 \u091c\u094b traffic \u092e\u0947\u0902 \u0917\u0941\u0938\u094d\u0938\u0947 \u0938\u0947 \u092c\u0948\u0920\u093e \u0939\u094b\n\u0935\u094b \u0905\u0902\u0926\u0930 \u0938\u0947 \u092c\u0941\u0930\u093e \u0907\u0902\u0938\u093e\u0928 \u0939\u0940 \u0939\u094b...\n\u0936\u093e\u092f\u0926 \u0935\u094b \u0938\u0941\u092c\u0939 \u0909\u092c\u0932\u0924\u093e \u0926\u0942\u0927 \u092c\u091a\u093e \u0928 \u092a\u093e\u092f\u093e \u0939\u094b\n\u0914\u0930 \u0926\u0942\u0927 \u0915\u093e \u0915\u093e\u0932\u093e \u0916\u094b\u092f\u093e \u092c\u0928\u093e \u0915\u0947 \u0906\u092f\u093e \u0939\u094b", "\u0905\u0927\u0942\u0930\u0947 \u0938\u092a\u0928\u094b\u0902 \u0915\u0947 \u092c\u094b\u091d \u0915\u0947 \u0928\u0940\u091a\u0947\n\u0939\u0930 \u092a\u0942\u0930\u0940 \u0939\u094b\u0924\u0940 \u0916\u093c\u094d\u0935\u093e\u0939\u093f\u0936 \u0939\u0948\u0902 \u0935\u094b\n\u092e\u0947\u0930\u0940 \u0915\u0939\u093e\u0928\u0940 \u0915\u093e \u0938\u093f\u0930\u094d\u092b\u093c \u0915\u093f\u0930\u0926\u093e\u0930 \u0928\u0939\u0940\u0902\n\u0939\u0930 \u092a\u0928\u094d\u0928\u0947 \u092a\u0947 \u0932\u093f\u0916\u0940 \u0938\u094d\u092f\u093e\u0939\u0940 \u0939\u0948\u0902 \u0935\u094b", "\u0926\u094b \u092a\u093e\u0932\u094b\u0902 \u0915\u094b \u0922\u0942\u0902\u095d\u0928\u0947 \u0928\u093f\u0915\u0932\u0947 \u092e\u0902\u0926\u093f\u0930\u094b\u0902 \u092e\u0947\u0902, \u0936\u093f\u0935\u093e\u0932\u094b\u0902 \u092e\u0947\u0902\n\u091d\u093e\u0901\u0915 \u0915\u0947 \u0926\u0947\u0916\u093e \u0905\u0902\u0926\u0930 \u091c\u095b\u094d\u092c\u093e\u0924\u094b\u0902 \u0915\u0947 \u092a\u094d\u092f\u093e\u0932\u094b\u0902 \u092e\u0947\u0902\n\u092b\u093f\u0930 \u090f\u0939\u0938\u093e\u0938 \u0939\u0941\u0906 \u0905\u092a\u0928\u0947 \u092d\u0940\u0924\u0930 \u0939\u0940 \u0939\u0948 \u0935\u094b \u0916\u0926\u093e\u0928\n\u0926\u094b \u092a\u0932\u094b\u0902 \u0915\u0940 \u0924\u0932\u093e\u0936 \u0915\u0947 \u092a\u0940\u091b\u0947 \u0939\u0948 \u0905\u0930\u094d\u0938\u094b\u0902 \u0915\u0940 \u0909\u095c\u093e\u0928", "\u0915\u0939\u0928\u0947 \u0915\u094b \u0924\u094b \u0915\u0941\u091b \u0932\u093f\u0916\u0924\u093e \u0939\u0942\u0901 \u092e\u0948\u0902\n\u092a\u0930 \u092e\u0947\u0930\u0940 \u0932\u093f\u0916\u093e\u0935\u091f \u0915\u093e \u0938\u092c\u092c \u0939\u0948\u0902 \u0935\u094b\n\u0939\u0930 \u0916\u093e\u0932\u0940 \u0915\u093e\u0917\u091c\u093c \u0915\u094b \u092d\u0930 \u0926\u0947\u0902\n\u0910\u0938\u0940 \u0905\u0939\u092e\u093f\u092f\u0924 \u0915\u0940 \u0938\u093e\u091c\u093c \u0939\u0948\u0902 \u0935\u094b"]