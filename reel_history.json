["\u0935\u0958\u094d\u0924 \u0915\u093e \u0915\u094d\u092f\u093e, \u092f\u0947 \u0924\u094b \u095b\u093f\u0928\u094d\u0926\u0917\u0940 \u0915\u0940 \u092e\u093e\u092f\u093e \u0939\u0948\n\u091c\u093f\u0924\u0928\u093e \u092a\u0915\u095c\u0928\u093e \u091a\u093e\u0939\u093e \u0909\u0924\u0928\u093e \u0939\u0940 \u0938\u0924\u093e\u0924\u093e \u0939\u0948\n\u095b\u093f\u0928\u094d\u0926\u0917\u0940 \u0915\u0940 \u0932\u0939\u0930 \u092e\u0947\u0902 \u0930\u0947\u0924 \u091c\u0948\u0938\u093e \u092c\u0939 \u0915\u0947\n\u092a\u0932-\u0926\u0930-\u092a\u0932 \u0905\u0928\u091c\u093e\u0928 \u0915\u0939\u093e\u0928\u0940 \u0938\u0941\u0928\u093e\u0924\u093e \u0939\u0948", "\u092e\u0938\u0930\u0942\u092b \u0938\u0940 \u095b\u093f\u0928\u094d\u0926\u0917\u0940 \u092e\u0947\u0902 \u0939\u0948 \u0926\u094b \u092a\u0932 \u0915\u0940 \u0916\u094b\u091c\n\u0926\u094b \u092a\u0932 \u0915\u0947 \u0938\u0941\u0915\u0942\u0928 \u092e\u0947\u0902 \u091c\u0948\u0938\u0947 \u0932\u093f\u092a\u091f\u093e \u0939\u0941\u0906 \u092c\u094b\u091d", "\u0939\u093e\u0901, \u092e\u0941\u091d\u0947 \u0921\u0930 \u0938\u093e \u0932\u0917\u0924\u093e \u0939\u0948,\n\u091c\u0948\u0938\u0947 \u0915\u094b\u0908 \u092d\u0942\u0932\u093e \u0938\u092a\u0928\u093e \u0938\u093e \u0932\u0917\u0924\u093e \u0939\u0948\n\u0915\u092d\u0940 \u0915\u0941\u091b \u0915\u0939 \u0928 \u092a\u093e\u0928\u093e \u092d\u0940 \u0906\u0938\u093e\u0928 \u0939\u094b\u0924\u093e \u0939\u0948,\n\u0914\u0930 \u0915\u092d\u0940 \u0938\u091a \u092c\u094b\u0932 \u0926\u0942\u0901 \u0924\u094b \u0928\u0941\u0915\u0938\u093e\u0928 \u0939\u094b\u0924\u093e \u0939\u0948\n\u0915\u0908 \u092c\u093e\u0930 \u0935\u094b \u092c\u093e\u0924\u0947\u0902 \u092d\u0940 \u0938\u091a \u092e\u093e\u0928 \u0932\u0947\u0924\u093e \u0939\u0942\u0901,\n\u091c\u094b \u0938\u0941\u0915\u0942\u0928 \u0926\u0947\u0902, \u092c\u0938 \u0909\u0928\u094d\u0939\u0947\u0902 \u0925\u093e\u092e \u0932\u0947\u0924\u093e \u0939\u0942\u0901\n\u092e\u0948\u0902 \u091c\u093e\u0928\u0924\u093e \u0939\u0942\u0901 \u0915\u093f \u0920\u0939\u0930\u0928\u093e \u0907\u0938\u0915\u093e \u0939\u0932 \u0928\u0939\u0940\u0902,\n\u092a\u0930 \u0939\u0930 \u0938\u0935\u093e\u0932 \u0915\u093e \u091c\u0935\u093e\u092c \u092d\u0940 \u0924\u094b \u0928\u0939\u0940\u0902", "\u091c\u092c \u0915\u092d\u0940 \u092e\u0928 \u0909\u0926\u093e\u0938 \u0939\u094b, \r\n\u0924\u094b \u091a\u091f\u094d\u091f\u093e\u0928 \u0938\u0940 \u0916\u0921\u093c\u0940 \u0930\u0939\u0924\u0940 \u0939\u0948\r\n\u0925\u094b\u0921\u093c\u093e \u092c\u0947\u0939\u0932\u093e-\u092b\u0941\u0938\u0932\u093e \u0915\u0930 \u0936\u093e\u0902\u0924 \u0915\u0930 \u0915\u0947, \r\n\u0935\u094b \u092e\u0941\u0938\u094d\u0915\u0941\u0930\u093e\u0924\u0947 \u0939\u0941\u090f \u092e\u093f\u0932\u0924\u0940 \u0939\u0948", "\u0924\u0947\u0930\u0940 \u095b\u0941\u0932\u094d\u095e\u094b\u0902 \u0915\u0940 \u091b\u093e\u092f \u092e\u0947\u0902, \u0935\u095e\u093e \u0938\u0947 \u0939\u0941\u0906 \u0930\u0942\u092c\u0930\u0942 \n\u092b\u093f\u0930 \u0906\u0926\u0924\u0947\u0902 \u092c\u0926\u0932 \u0917\u092f\u0940, \u0924\u0942 \u0939\u0940 \u092c\u0924\u093e \u0905\u092c \u0915\u094d\u092f\u093e \u0915\u0930\u0942"]