["\u0917\u093c\u0941\u0938\u094d\u0938\u0947 \u0938\u0947 \u0909\u092c\u0932\u0924\u0947 \u091c\u091c\u093c\u094d\u092c\u093e\u0924 \u0915\u0947 \u0938\u093e\u092e\u0928\u0947\n\u0938\u0928\u094d\u0928\u093e\u091f\u0947 \u0915\u0940 \u0928\u0930\u092e \u0917\u0942\u0901\u091c \u0939\u0948\u0902 \u0935\u094b\n\u0925\u0915\u093e\u0928 \u0938\u0947 \u0932\u0939\u0942\u0932\u0941\u0939\u093e\u0928 \u0907\u0938 \u0938\u092b\u093c\u0930 \u092e\u0947\u0902\n\u0939\u0930 \u092e\u094b\u0921\u093c \u092a\u0930 \u092e\u093f\u0932\u0924\u0940 \u0930\u0939\u092e\u0924 \u0939\u0948\u0902 \u0935\u094b", "\u0935\u0958\u094d\u0924 \u0915\u094b \u0917\u0941\u095b\u0930\u0924\u0947 \u0926\u0947\u0916\u093e \u0939\u0948 \u0915\u092d\u0940?\n\u0924\u0942\u095e\u093e\u0928 \u091c\u0948\u0938\u0940 \u092c\u093f\u0916\u0947\u0930\u0940 \u0939\u0948\n\u0907\u0938 \u092e\u0941\u0936\u094d\u0915\u093f\u0932 \u0926\u094c\u0930 \u092e\u0947\u0902 \u0909\u095c\u093e\u0928 \u092d\u0930\u0928\u0947 \u0915\u094b\n\u092c\u0938 \u0925\u094b\u095c\u0947 \u0938\u093e\u0939\u0938 \u0915\u0940 \u0926\u0947\u0930\u0940 \u0939\u0948", "\u0907\u0938 \u092c\u093e\u0930 \u0915\u0940 \u0926\u093f\u0935\u093e\u0932\u0940 \u0915\u0941\u091b \u0905\u0932\u0917 \u0938\u0940 \u0925\u0940\n\u0928\u093e \u092a\u091f\u093e\u0916\u094b\u0902 \u0915\u0940 \u0926\u094c\u0921\u093c \u0925\u0940,\n\u0914\u0930 \u0928\u093e \u0925\u0940 \u0936\u094b\u0930 \u0915\u093e \u0939\u093f\u0938\u094d\u0938\u093e \u092c\u0928\u0928\u0947 \u0915\u0940 \u091a\u093e\u0939\n\n\u0936\u093e\u092e \u0915\u094b \u0918\u0930 \u0935\u093e\u092a\u0938 \u0906\u0915\u0930 \u0906\u0938\u092e\u093e\u0928 \u0915\u094b \u0926\u0947\u0916\u093e,\n\u091c\u093f\u0938\u092e\u0947\u0902 \u0906\u0924\u093f\u0936\u092c\u093e\u091c\u093c\u0940 \u0924\u094b \u0928\u0939\u0940\u0902 \u0925\u0940,\n\u092a\u0930 \u0922\u0932\u0924\u0947 \u0939\u0941\u090f \u0938\u0942\u0930\u091c \u0928\u0947\n\u090f\u0915 \u092c\u0947\u0939\u0924\u0930\u0940\u0928 \u0924\u0938\u094d\u0935\u0940\u0930 \u092c\u0928\u093e\u0908 \u0925\u0940..\n\n\u0914\u0930 \u0907\u0938 \u0938\u092c \u0915\u0947 \u092c\u0940\u091a,\n\u090f\u0915 \u0905\u091c\u0940\u092c \u0938\u093e \u0905\u092a\u0928\u093e\u092a\u0928 \u092e\u0939\u0938\u0942\u0938 \u0939\u0941\u0906", "\u091c\u093c\u0930\u0942\u0930\u0940 \u0928\u0939\u0940\u0902 \u0939\u0930 \u0909\u0926\u093e\u0938 \u0907\u0902\u0938\u093e\u0928 \u0926\u0941\u0916\u0940 \u0939\u0940 \u0939\u094b\n\u0939\u094b \u0938\u0915\u0924\u093e \u0939\u0948 \u0915\u094b\u0908 \u0909\u0938\u0915\u0940 \u091a\u093e\u092f \u092a\u0940 \u0917\u092f\u093e \u0939\u094b...\n\u090f\u0915 \u092a\u094d\u092f\u093e\u0932\u0947 \u0938\u0947 \u0939\u094b\u0924\u0940 \u0939\u0948 \u0939\u0930 \u0926\u093f\u0928 \u0915\u0940 \u0936\u0941\u0930\u0941\u0906\u0924\n\u0914\u0930 \u0928 \u092e\u093f\u0932\u0947 \u0924\u094b \u091c\u0948\u0938\u0947 \u0915\u094b\u0908 \u0926\u093f\u0932 \u092a\u0947 \u0932\u0917 \u0917\u092f\u0940 \u0939\u094b \u092c\u093e\u0924", "\u0930\u0942\u0939 \u0915\u094b \u0939\u0948 \u091b\u0942 \u0932\u093f\u092f\u093e, \u0928\u095b\u0926\u0940\u0915\u093f\u092f\u094b\u0902 \u0915\u0940 \u0926\u0947\u0930\u0940 \u0939\u0948 \n\u0916\u0941\u0926 \u0916\u0941\u0926\u093e \u0928\u0947 \u092d\u0940 \u092e\u093e\u0928\u093e \u0939\u0948, \u092f\u0947 \u092c\u093e\u0924 \u0924\u0947\u0930\u0940 \u092e\u0947\u0930\u0940 \u0939\u0948"]