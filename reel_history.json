["\u091c\u093c\u0930\u093e \u0938\u093e \u0935\u0958\u094d\u0924 \u0930\u0941\u0915 \u091c\u093e\u090f \u0915\u0939\u0940\u0902\n\u0938\u093f\u0930\u094d\u092b \u090f\u0915 \u0932\u092e\u094d\u0939\u093e \u0920\u0939\u0930 \u091c\u093e\u090f \u0915\u0939\u0940\u0902\n\u0909\u0938 \u0932\u092e\u094d\u0939\u0947 \u092e\u0947\u0902 \u091b\u093f\u092a\u0940 \u0939\u0948\u0902 \u0905\u0917\u0923\u093f\u0924 \u0915\u0939\u093e\u0928\u093f\u092f\u093e\u0901\n\u091c\u094b \u0939\u094b\u0924\u0940 \u0928\u0939\u0940\u0902 \u092c\u092f\u093e\u0902 \u0935\u0958\u094d\u0924 \u0915\u0940 \u0917\u0939\u0930\u093e\u0908 \u092e\u0947\u0902 \u0915\u0939\u0940\u0902", "\u0907\u0938 \u092c\u093e\u0930 \u092e\u093f\u0920\u093e\u0907\u092f\u093e\u0901 \u092c\u0938 \u090f\u0915 \u0921\u093f\u092c\u094d\u092c\u0947 \u092e\u0947\u0902 \u0938\u093f\u092e\u091f \u0917\u0908\u0902,\n\u091c\u093f\u0928\u092e\u0947\u0902 \u0930\u0902\u0917 \u0924\u094b \u092c\u0922\u093c\u093f\u092f\u093e \u0925\u093e,\n\u092a\u0930 \u090f\u0915 \u0935\u094b \u0918\u0930 \u0935\u093e\u0932\u0940 \u0916\u0941\u0936\u092c\u0942 \u0915\u0940 \u0915\u092e\u0940 \u0932\u0917\u0940\n\n\u0930\u0938\u094b\u0908 \u092e\u0947\u0902 \u0915\u0941\u091b \u092a\u0915\u0935\u093e\u0928 \u0924\u094b \u091c\u093c\u0930\u0942\u0930 \u092c\u0928\u0947,\n\u092a\u0930 \u0909\u0924\u0928\u0947 \u0928\u0939\u0940\u0902 \u091c\u093f\u0924\u0928\u0947 \u092a\u0939\u0932\u0947 \u092c\u0928\u0924\u0947 \u0925\u0947\n\n\u092b\u094b\u0928 \u092a\u0930 \u0938\u092c \u0938\u0947 \u092c\u093e\u0924 \u092d\u0940 \u0939\u0941\u0908,\n\u091c\u093f\u0938\u092e\u0947\u0902 \u0925\u094b\u0921\u093c\u0940 \u0939\u0901\u0938\u0940 \u0914\u0930 \u0925\u094b\u0921\u093c\u0940 \u0916\u093e\u092e\u094b\u0936\u0940 \u0925\u0940\n\n\u0914\u0930 \u0926\u0941\u0915\u093e\u0928 \u0938\u0947 \u0916\u0930\u0940\u0926\u0940 \u0939\u0941\u0908 \u090f\u0915 \u092e\u093e\u0932\u093e \u092d\u0940 \u0925\u0940,  \n\u091c\u094b \u0928\u092f\u0940 \u092e\u0942\u0930\u094d\u0924\u093f\u092f\u094b\u0902 \u092a\u0930 \u0938\u091c\u0924\u0940 \u0939\u0941\u0908 \u092e\u0941\u0938\u094d\u0915\u0941\u0930\u093e \u0930\u0939\u0940 \u0925\u0940", "\u091d\u0947\u0932\u092e \u0938\u093e \u092c\u0939 \u0915\u0947\n\u091a\u091f\u094d\u091f\u093e\u0928\u094b\u0902 \u092e\u0947\u0902 \u0930\u093e\u0938\u094d\u0924\u093e \u0924\u0932\u093e\u0936 \u0915\u0947\n\u091c\u092c \u0938\u093e\u0917\u0930 \u092e\u0947\u0902 \u092e\u093f\u0932 \u0915\u0947 \u090f\u0915 \u0939\u094b \u091c\u093e\u0913\u0917\u0940\n\u092c\u0938 \u0907\u0924\u0928\u093e \u092c\u0924\u093e\u0913\n\u092b\u093f\u0930 \u092e\u0941\u091d\u0938\u0947 \u092e\u093f\u0932\u094b\u0917\u0940 \u0915\u094d\u092f\u093e?", "\u0926\u0947\u0930 \u0938\u0947 \u0915\u092d\u0940 \u0918\u0930 \u0906\u090a\u0902 \u0924\u094b, \n\u0928\u093e\u0915 \u092a\u0947 \u0917\u0941\u0938\u094d\u0938\u093e \u0932\u093f\u090f \u0926\u093f\u0916\u0924\u0940 \u0939\u0948\n\u092a\u0930 \u0916\u093c\u094d\u0935\u093e\u092c\u094b\u0902 \u092e\u0947\u0902 \u0939\u092e\u0947\u0936\u093e \u092e\u0941\u091d\u0947, \n\u0935\u094b \u092e\u0941\u0938\u094d\u0915\u0941\u0930\u093e\u0924\u0947 \u0939\u0941\u090f \u092e\u093f\u0932\u0924\u0940 \u0939\u0948", "\u092a\u0938\u0940\u0928\u0947 \u0915\u0940 \u090f\u0915 \u092c\u0942\u0901\u0926 \u091c\u092c \u092e\u093f\u091f\u094d\u091f\u0940 \u092e\u0947\u0902 \u092e\u093f\u0932\u0940\n\u092e\u0947\u0939\u0928\u0924 \u0915\u0940 \u092e\u0939\u0915 \u0939\u0930 \u0915\u094b\u0928\u0947 \u092e\u0947\u0902 \u0916\u093f\u0932\u0940\n\u0938\u093f\u0930\u094d\u092b \u0936\u094d\u0930\u092e \u0938\u0947 \u0928\u0939\u0940\u0902 \u0939\u094b\u0924\u0940 \u092f\u0947 \u0927\u0930\u0924\u0940 \u0939\u0930\u0940\n\u0925\u094b\u095c\u093e \u092a\u094d\u092f\u093e\u0930, \u0925\u094b\u095c\u093e \u0938\u092c\u094d\u0930 \u092d\u0940 \u0939\u0948 \u095b\u0930\u0942\u0930\u0940"]