["\u0915\u092d\u0940 \u0916\u0941\u0926 \u0938\u0947 \u0932\u0921\u093c\u0947 \u0939\u092e,\n\u0915\u092d\u0940 \u0926\u0941\u0928\u093f\u092f\u093e \u0938\u0947 \u092d\u0940\n\u0915\u092d\u0940 \u0938\u091a \u0915\u0947 \u0932\u093f\u090f \u0916\u0921\u093c\u0947,\n\u0915\u092d\u0940 \u091a\u0941\u092a \u0925\u0947 \u0938\u092d\u0940\n\n\u0915\u0941\u091b \u0930\u093f\u0936\u094d\u0924\u0947 \u0925\u093e\u092e\u0947 \u0925\u0947,\n\u0926\u093f\u0932 \u0915\u0940 \u0921\u094b\u0930 \u0938\u0947\n\u0915\u0941\u091b \u091b\u0942\u091f \u0917\u090f \u0927\u0940\u0930\u0947-\u0927\u0940\u0930\u0947\n\u0938\u092e\u092f \u0915\u0940 \u0939\u094b\u0921\u093c \u092e\u0947\u0902\n\n\u092f\u0947 \u091c\u094b \u0917\u0941\u091c\u093c\u0930\u093e \u0939\u0948,\n\u092f\u0947 \u092b\u093c\u093e\u0938\u0932\u0947 \u0928\u0939\u0940\u0902, \u092f\u0947 \u092a\u0939\u091a\u093e\u0928 \u0939\u0948..", "\u0905\u092a\u0928\u0940 \u091a\u093e\u0939\u0924\u094b\u0902 \u0915\u0947 \u092a\u0940\u091b\u0947 \u092d\u093e\u0917\u0947, \u0915\u0930\u094d\u0924\u0935\u094d\u092f\u094b\u0902 \u0938\u0947 \u091c\u0942\u091d\u0924\u0947 \u0930\u0939\u0947\n\"\u0938\u093e\u0930\u0940 \u095b\u093f\u0928\u094d\u0926\u0917\u0940 \u092a\u095c\u0940 \u0939\u0948\" \u0938\u094b\u091a \u0915\u0930 \u0916\u0941\u0926 \u0915\u094b \u092c\u0942\u091d\u0924\u0947 \u0930\u0939\u0947\n\u0914\u0930 \u091c\u092c \u0925\u0915 \u0915\u0947 \u092c\u0948\u0920\u0947 \u0926\u094b \u092a\u0932 \u0915\u0947 \u0932\u093f\u090f\n\u090f\u0915 \u0928\u092f\u0940 \u092a\u0939\u0947\u0932\u0940 \u0915\u0947 \u092a\u0940\u091b\u0947 \u0909\u0920 \u0915\u0930 \u091a\u0932 \u0926\u093f\u090f", "\u0938\u093f\u0930\u094d\u092b \u0928\u095b\u0930 \u0928\u0939\u0940\u0902 \u0928\u095b\u0930\u093f\u092f\u0947 \u0915\u093e \u0939\u0948 \u0916\u0947\u0932\n\u090f\u0915 \u092c\u0947\u0939\u0926 \u0916\u0942\u092c\u0938\u0942\u0930\u0924 \u095b\u093f\u0928\u094d\u0926\u0917\u0940 \u0915\u0940 \u0930\u095e\u094d\u0924\u093e\u0930 \u091c\u0948\u0938\u0947 \u0939\u094b \u0930\u0947\u0932\n\u0915\u0939\u0940\u0902 \u0926\u094b \u092a\u0932 \u0915\u0940 \u092d\u0942\u0915 \u0939\u0948 \u0924\u094b \u0915\u0939\u0940\u0902 \u0939\u0948 \u0926\u094b \u092a\u0932 \u0915\u0940 \u092a\u094d\u092f\u093e\u0938\n\u0932\u093e\u095b\u093f\u092e\u0940 \u0928\u0939\u0940\u0902 \u0914\u0930 \u0915\u0941\u091b \u092c\u0938 \u092f\u0947 \u0926\u094b \u092a\u0932 \u0939\u0940 \u0939\u0948\u0902 \u0959\u093e\u0938", "\u091c\u093c\u0930\u0942\u0930\u0940 \u0928\u0939\u0940\u0902 \u0939\u0930 \u0909\u0926\u093e\u0938 \u0907\u0902\u0938\u093e\u0928 \u0926\u0941\u0916\u0940 \u0939\u0940 \u0939\u094b\n\u0939\u094b \u0938\u0915\u0924\u093e \u0939\u0948 \u0915\u094b\u0908 \u0909\u0938\u0915\u0940 \u091a\u093e\u092f \u092a\u0940 \u0917\u092f\u093e \u0939\u094b...\n\u090f\u0915 \u092a\u094d\u092f\u093e\u0932\u0947 \u0938\u0947 \u0939\u094b\u0924\u0940 \u0939\u0948 \u0939\u0930 \u0926\u093f\u0928 \u0915\u0940 \u0936\u0941\u0930\u0941\u0906\u0924\n\u0914\u0930 \u0928 \u092e\u093f\u0932\u0947 \u0924\u094b \u091c\u0948\u0938\u0947 \u0915\u094b\u0908 \u0926\u093f\u0932 \u092a\u0947 \u0932\u0917 \u0917\u092f\u0940 \u0939\u094b \u092c\u093e\u0924", "\u0915\u0932 \u0915\u0940 \u091a\u093f\u0902\u0924\u093e \u092e\u0947\u0902,\n\u0906\u091c \u0915\u094b \u0916\u094b\u092f\u093e\n\u092c\u0940\u0924\u0947 \u092a\u0932\u094b\u0902 \u0915\u094b \u092f\u093e\u0926 \u0915\u0930,\n\u0905\u0915\u094d\u0938\u0930 \u092c\u0939\u0941\u0924 \u0930\u094b\u092f\u093e\n\n\u0938\u092e\u091d \u0906\u092f\u093e \u0927\u0940\u0930\u0947-\u0927\u0940\u0930\u0947,\n\u0939\u0930 \u0920\u094b\u0915\u0930 \u0915\u093e \u092e\u0924\u0932\u092c \u0925\u093e\n\u091c\u094b \u092c\u0940\u0924\u093e \u0935\u0939\u0940 \u092d\u0940\u0924\u0930\n\u092e\u0947\u0930\u0947 \u0939\u094b\u0928\u0947 \u0915\u093e \u0938\u092c\u0915 \u0925\u093e\n\n\u092f\u0947 \u091c\u094b \u0917\u0941\u091c\u093c\u0930\u093e \u0939\u0948,\n\u092f\u0947 \u0935\u0915\u093c\u094d\u0924 \u0928\u0939\u0940\u0902, \u092f\u0947 \u091c\u0940\u0935\u0928 \u0939\u0948.."]