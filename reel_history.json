["\u0930\u093e\u0939\u094b\u0902 \u0915\u0940 \u0909\u0932\u091d\u0928 \u092e\u0947\u0902 \u092e\u0936\u093e\u0932 \u0915\u0940 \u0924\u0930\u0939\n\u0917\u0939\u0930\u0947 \u0905\u0901\u0927\u0947\u0930\u0947 \u092e\u0947\u0902 \u0939\u093f\u092e\u094d\u092e\u0924 \u0926\u093f\u0932\u093e\u0924\u0947 \u0935\u094b\n\u0939\u0930 \u0915\u0926\u092e \u092a\u0930 \u0930\u093e\u0939 \u0926\u093f\u0916\u093e\u0928\u0947 \u0935\u093e\u0932\u0947\n\u0935\u094b \u0915\u094b\u0908 \u0914\u0930 \u0928\u0939\u0940\u0902, \u092c\u0938 \u092e\u0947\u0930\u0947 \u092a\u093f\u0924\u093e \u0939\u0948\u0902 \u0935\u094b", "\u090f\u0915 \u092e\u093e\u0938\u0942\u092e \u0938\u0940 \u0932\u095c\u0915\u0940 \u0915\u0940 \u092e\u093e\u0938\u0942\u092e\u093f\u092f\u0924 \u091a\u0940\u0928 \u0932\u0940 \u091c\u093e\u0924\u0940 \u0939\u0948\n\"\u092c\u094b\u091d \u0939\u0948 \u092f\u0947\" \u0915\u0939\u0915\u0930 \u0909\u0938\u0915\u0940 \u091b\u0935\u093f \u0917\u093f\u0930\u093e\u092f\u0940 \u091c\u093e\u0924\u0940 \u0939\u0948\n\u0932\u095c\u0915\u0940 \u0915\u094b \u0905\u0917\u0930 \u0935\u094b \u0926\u0930\u094d\u091c\u093e \u0928\u093e \u092e\u093f\u0932\u093e \u092f\u0947 \u0932\u093e\u0907\u0932\u093e\u091c \u092c\u093f\u092e\u093e\u0930\u0940 \u0939\u0948\n\u0938\u092e\u093e\u091c \u0915\u094b \u0917\u093e\u0932\u0940 \u0915\u094d\u092f\u094b\u0902 \u0926\u0947\u0924\u0947 \u0939\u0948\u0902, \u092f\u0947 \u0938\u092e\u093e\u091c \u092a\u0930\u091b\u093e\u0908 \u0939\u092e\u093e\u0930\u0940 \u0939\u0948", "\u0939\u093e\u0901, \u092e\u0941\u091d\u0947 \u0921\u0930 \u0938\u093e \u0932\u0917\u0924\u093e \u0939\u0948,\n\u091c\u0948\u0938\u0947 \u0915\u094b\u0908 \u092d\u0942\u0932\u093e \u0938\u092a\u0928\u093e \u0938\u093e \u0932\u0917\u0924\u093e \u0939\u0948\n\u0915\u092d\u0940 \u0915\u0941\u091b \u0915\u0939 \u0928 \u092a\u093e\u0928\u093e \u092d\u0940 \u0906\u0938\u093e\u0928 \u0939\u094b\u0924\u093e \u0939\u0948,\n\u0914\u0930 \u0915\u092d\u0940 \u0938\u091a \u092c\u094b\u0932 \u0926\u0942\u0901 \u0924\u094b \u0928\u0941\u0915\u0938\u093e\u0928 \u0939\u094b\u0924\u093e \u0939\u0948\n\u0915\u0908 \u092c\u093e\u0930 \u0935\u094b \u092c\u093e\u0924\u0947\u0902 \u092d\u0940 \u0938\u091a \u092e\u093e\u0928 \u0932\u0947\u0924\u093e \u0939\u0942\u0901,\n\u091c\u094b \u0938\u0941\u0915\u0942\u0928 \u0926\u0947\u0902, \u092c\u0938 \u0909\u0928\u094d\u0939\u0947\u0902 \u0925\u093e\u092e \u0932\u0947\u0924\u093e \u0939\u0942\u0901\n\u092e\u0948\u0902 \u091c\u093e\u0928\u0924\u093e \u0939\u0942\u0901 \u0915\u093f \u0920\u0939\u0930\u0928\u093e \u0907\u0938\u0915\u093e \u0939\u0932 \u0928\u0939\u0940\u0902,\n\u092a\u0930 \u0939\u0930 \u0938\u0935\u093e\u0932 \u0915\u093e \u091c\u0935\u093e\u092c \u092d\u0940 \u0924\u094b \u0928\u0939\u0940\u0902", "\u0939\u093e\u0901, \u092e\u0941\u091d\u0947 \u0921\u0930 \u0938\u093e \u0932\u0917\u0924\u093e \u0939\u0948,\n\u0914\u0930 \u0915\u092d\u0940 \u0907\u0938 \u0921\u0930 \u0938\u0947 \u0921\u0930 \u092d\u0940 \u0932\u0917\u0924\u093e \u0939\u0948\n\u092b\u093f\u0930 \u092d\u0940 \u0939\u0930 \u0930\u094b\u091c\u093c \u0915\u0941\u091b \u0906\u0917\u0947 \u092c\u0922\u093c\u0924\u093e \u0939\u0942\u0901 \u092e\u0948\u0902,\n\u0921\u0930 \u0915\u094b \u0938\u093e\u0925 \u0932\u0947\u0915\u0930 \u0939\u0940 \u0925\u094b\u0921\u093c\u093e \u0938\u093e \u091a\u0932\u0924\u093e \u0939\u0942\u0901 \u092e\u0948\u0902", "\u0907\u0938 \u092c\u093e\u0930 \u0915\u0940 \u0926\u093f\u0935\u093e\u0932\u0940 \u0915\u0941\u091b \u0905\u0932\u0917 \u0938\u0940 \u0925\u0940\n\u0928\u093e \u092a\u091f\u093e\u0916\u094b\u0902 \u0915\u0940 \u0926\u094c\u0921\u093c \u0925\u0940,\n\u0914\u0930 \u0928\u093e \u0925\u0940 \u0936\u094b\u0930 \u0915\u093e \u0939\u093f\u0938\u094d\u0938\u093e \u092c\u0928\u0928\u0947 \u0915\u0940 \u091a\u093e\u0939\n\n\u0936\u093e\u092e \u0915\u094b \u0918\u0930 \u0935\u093e\u092a\u0938 \u0906\u0915\u0930 \u0906\u0938\u092e\u093e\u0928 \u0915\u094b \u0926\u0947\u0916\u093e,\n\u091c\u093f\u0938\u092e\u0947\u0902 \u0906\u0924\u093f\u0936\u092c\u093e\u091c\u093c\u0940 \u0924\u094b \u0928\u0939\u0940\u0902 \u0925\u0940,\n\u092a\u0930 \u0922\u0932\u0924\u0947 \u0939\u0941\u090f \u0938\u0942\u0930\u091c \u0928\u0947\n\u090f\u0915 \u092c\u0947\u0939\u0924\u0930\u0940\u0928 \u0924\u0938\u094d\u0935\u0940\u0930 \u092c\u0928\u093e\u0908 \u0925\u0940..\n\n\u0914\u0930 \u0907\u0938 \u0938\u092c \u0915\u0947 \u092c\u0940\u091a,\n\u090f\u0915 \u0905\u091c\u0940\u092c \u0938\u093e \u0905\u092a\u0928\u093e\u092a\u0928 \u092e\u0939\u0938\u0942\u0938 \u0939\u0941\u0906"]